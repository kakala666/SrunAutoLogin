<Window x:Class="SrunAutoLogin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="校园网自动登录" Height="700" Width="470" Icon="favicon.ico"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.WindowBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 + 状态 -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="校园网自动登录" FontSize="17" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#FF9CA3AF" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="已停止" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock x:Name="TxtDetail" Text="" Margin="20,4,0,0"
                           Foreground="{StaticResource B.TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 中部可滚动配置区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <StackPanel>
                <!-- 账号设置 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="账号设置" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="手机号 / 账号" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtPhone" Style="{StaticResource ModernTextBox}"/>
                        <TextBlock Text="密码" Style="{StaticResource FieldLabel}" Margin="2,12,0,4"/>
                        <PasswordBox x:Name="PwdBox" Style="{StaticResource ModernPasswordBox}"/>
                        <TextBlock Text="运营商" Style="{StaticResource FieldLabel}" Margin="2,12,0,4"/>
                        <ComboBox x:Name="CmbDomain" Style="{StaticResource ModernComboBox}"
                                  ItemContainerStyle="{StaticResource ModernComboItem}">
                            <ComboBoxItem Content="中国电信 (@telecom)" Tag="@telecom"/>
                            <ComboBoxItem Content="中国联通 (@unicom)" Tag="@unicom"/>
                            <ComboBoxItem Content="中国移动 (@cmcc)" Tag="@cmcc"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- 高级设置 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="高级设置" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="门户服务器地址" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtHost" Style="{StaticResource ModernTextBox}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ac_id" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtAcId" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="检查间隔(秒)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtInterval" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 行为 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="行为" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="TglWatchdog" Style="{StaticResource ToggleSwitch}" Content="启用掉线守护(自动重登)"/>
                        <CheckBox x:Name="TglAutoStart" Style="{StaticResource ToggleSwitch}" Content="开机自启" Margin="0,12,0,0"/>
                        <CheckBox x:Name="TglStartMin" Style="{StaticResource ToggleSwitch}" Content="启动即最小化到托盘" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 日志 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="运行日志" Style="{StaticResource SectionTitle}"/>
                        <Border Background="{StaticResource B.InputBg}" BorderBrush="{StaticResource B.InputBorder}"
                                BorderThickness="1" CornerRadius="6">
                            <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource B.TextSecondary}" FontFamily="Consolas, Microsoft YaHei UI"
                                     FontSize="11.5" Height="120" Padding="8"
                                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnSave" Grid.Column="0" Content="保存并应用" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
            <Button x:Name="BtnLogin" Grid.Column="2" Content="立即登录" Style="{StaticResource SecondaryButton}" Click="BtnLogin_Click"/>
            <Button x:Name="BtnMinimize" Grid.Column="4" Content="最小化到托盘" Style="{StaticResource SecondaryButton}" Click="BtnMinimize_Click"/>
        </Grid>
    </Grid>
</Window>
